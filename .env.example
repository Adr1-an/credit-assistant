# Пример настроек. Скопируйте этот файл в .env и заполните.
# .env в репозиторий НЕ попадает (.gitignore). Этот файл — попадает, поэтому здесь без ключей.

# ---------- Прокси GigaChat (gpt2giga) ----------
# Ключ авторизации GigaChat из личного кабинета Sber Developers
GIGACHAT_CREDENTIALS=
# Тип доступа: обычно GIGACHAT_API_PERS (для физлиц); если ключ выдан для бизнеса — тот, что указан рядом с ключом
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Порт прокси. Не 8090 — там работают заглушки
GPT2GIGA_PORT=8091
GPT2GIGA_HOST=0.0.0.0
# Прокси пускает только с этим ключом. Придумайте длинную случайную строку (32+ символа)
GPT2GIGA_ENABLE_API_KEY_AUTH=True
GPT2GIGA_API_KEY=
# Сертификат Минцифры для связи с GigaChat (см. certs/README.md). Без него — ошибка SSL.
# В Docker:
GIGACHAT_CA_BUNDLE_FILE=/certs/russian_trusted_root_ca_pem.crt
# Только для проверки на своём компьютере, если сертификата нет (небезопасно):
# GIGACHAT_VERIFY_SSL_CERTS=False

# ---------- Бэк: как обращаться к ИИ (contract/llm-contract.md) ----------
# true — ИИ включён; без ключа поставьте false, всё будет работать через форму
LLM_ENABLED=false
# Локально: http://localhost:8091/v1 ; в Docker: http://gpt2giga:8091/v1
LLM_BASE_URL=http://localhost:8091/v1
# Адрес модели внутри Docker. По умолчанию — прокси gpt2giga. Для Ollama на этом же компьютере:
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# То же значение, что GPT2GIGA_API_KEY выше
LLM_API_KEY=
LLM_MODEL=GigaChat-2-Max
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# ---------- Бэк: прочее (contract/README.md) ----------
EVALUATION_DATE=2026-10-24
MOCKS_URL=http://localhost:8090
